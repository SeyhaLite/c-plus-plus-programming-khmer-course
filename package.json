{
  "name": "khmer-cpp-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Khmer C++ Academy — វេទិកាសិក្សា C++ ជាភាសាខ្មែរ (static, GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build-css.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "vitest run tests/curriculum",
    "report": "tsx scripts/build-report.ts",
    "check:cpp": "tsx scripts/check-cpp-examples.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans": "^5.1.0",
    "@fontsource/noto-sans-khmer": "^5.1.0",
    "codemirror": "^6.0.1"
  }
}